// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// USUÁRIO
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// DIA A DIA
model Day {
  id        String   @id @default(cuid())
  date      DateTime @unique
  type      DayType  @default(NORMAL)
  mood      String?
  energy    Energy?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  habits    HabitLog[]
  waterLogs WaterLog[]
  mealLogs  MealLog[]
  tasks     Task[]
  events    Event[]
}

enum DayType {
  NORMAL
  FAXINA
}

enum Energy {
  ALTA
  MEDIA
  BAIXA
}

model Habit {
  id        String     @id @default(cuid())
  name      String
  icon      String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  logs      HabitLog[]
}

model HabitLog {
  id      String  @id @default(cuid())
  done    Boolean @default(false)
  habitId String
  habit   Habit   @relation(fields: [habitId], references: [id], onDelete: Cascade)
  dayId   String
  day     Day     @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@unique([habitId, dayId])
}

model WaterLog {
  id       String   @id @default(cuid())
  amount   Float    @default(300)
  loggedAt DateTime @default(now())
  dayId    String
  day      Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
}

model Task {
  id         String    @id @default(cuid())
  title      String
  done       Boolean   @default(false)
  type       TaskType  @default(AVULSA)
  origin     Origin    @default(PESSOAL)
  dueDate    DateTime?
  order      Int       @default(0)
  createdAt  DateTime  @default(now())
  // Quando foi concluída — igual ProductionTask e CollectionTask, que já
  // tinham. Sem isto, marcar como feita não deixava rastro de quando, e um
  // projeto tocado ontem parecia parado para o radar. Nulo em tudo que foi
  // concluído antes deste campo existir: não dá para inventar a data.
  completedAt DateTime?
  dayId      String?
  day        Day?      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Cópia de rotina: aponta para o template que a gerou. Sem isso a cópia só
  // podia ser reconhecida pelo título, e renomear um template duplicava a
  // tarefa em todo dia já materializado.
  templateId String?
  template   Task?   @relation("RoutineTemplate", fields: [templateId], references: [id], onDelete: SetNull)
  instances  Task[]  @relation("RoutineTemplate")

  subtasks Subtask[]

  @@index([dayId])
  @@index([businessId])
  @@index([projectId])
  @@index([templateId])
  // Templates de rotina são as tarefas com dayId nulo.
  @@index([type, dayId])
  // Uma cópia de cada rotina por dia. Sem isto, dois carregamentos simultâneos
  // do /dia materializavam o mesmo template duas vezes e a lista aparecia
  // duplicada, sem nada acusando o erro. No Postgres nulo não conflita com
  // nulo, então templates (dayId nulo) e tarefas avulsas (templateId nulo)
  // continuam livres.
  @@unique([dayId, templateId])
}

enum TaskType {
  ROTINA_NORMAL
  ROTINA_FAXINA
  AVULSA
}

// Quebra de uma tarefa em passos menores. Pertence a exatamente uma tarefa — do
// dia a dia, de produção ou de coleção. Os três lados são opcionais aqui porque
// o Prisma não tem relação polimórfica; quem garante o "exatamente um" é o
// schema da API.
model Subtask {
  id        String   @id @default(cuid())
  title     String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  productionTaskId String?
  productionTask   ProductionTask? @relation(fields: [productionTaskId], references: [id], onDelete: Cascade)

  collectionTaskId String?
  collectionTask   CollectionTask? @relation(fields: [collectionTaskId], references: [id], onDelete: Cascade)

  @@index([taskId, order])
  @@index([productionTaskId, order])
  @@index([collectionTaskId, order])
}

// AGENDA
model Event {
  id          String        @id @default(cuid())
  title       String
  description String?
  date        DateTime
  time        String?
  endTime     String?
  allDay      Boolean       @default(false)
  category    EventCategory @default(PESSOAL)
  createdAt   DateTime      @default(now())
  // `@default(now())` além de `@updatedAt` para que a coluna possa ser
  // adicionada a uma tabela que já tenha eventos gravados.
  updatedAt   DateTime      @default(now()) @updatedAt

  // Sincronização com o Google Calendar.
  googleEventId    String?    @unique
  googleCalendarId String?
  lastSyncedAt     DateTime?
  syncStatus       SyncStatus @default(PENDENTE)

  dayId String?
  day   Day?    @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
  @@index([date])
  @@index([syncStatus])
}

enum SyncStatus {
  PENDENTE
  SINCRONIZADO
  ERRO
}

// Tokens do Google — registro único (a conta da dona do app).
model GoogleAuth {
  id           String   @id @default(cuid())
  // E-mail da conta conectada, lido do calendário primário na conexão.
  email        String?
  // Os dois cifrados (ver lib/crypto.ts): com eles em mãos qualquer um lê e
  // escreve na agenda. Quem decripta é o getAuthClient, em lib/google-calendar.
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Histórico de sincronizações — a última alimenta a tela de configurações.
model SyncLog {
  id         String        @id @default(cuid())
  direction  SyncDirection
  eventsFrom Int           @default(0)
  eventsTo   Int           @default(0)
  errors     String?       @db.Text
  syncedAt   DateTime      @default(now())

  @@index([syncedAt])
}

enum SyncDirection {
  APP_TO_GOOGLE
  GOOGLE_TO_APP
  BIDIRECIONAL
}

enum EventCategory {
  PESSOAL
  TAROT
  ACE
  CREATIVE
  SAUDE
  OUTRO
}

// CARDÁPIO E RECEITAS
model Recipe {
  id          String         @id @default(cuid())
  title       String
  description String?
  category    RecipeCategory
  ingredients String
  steps       String
  prepTime    Int?
  imageUrl    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  mealPlans   MealPlan[]
  mealLogs    MealLog[]
}

enum RecipeCategory {
  CAFE_DA_MANHA
  ALMOCO
  JANTAR
  LANCHE
  SOBREMESA
  OUTRO
}

model MealPlan {
  id        String   @id @default(cuid())
  weekStart DateTime
  dayOfWeek Int
  mealType  MealType
  createdAt DateTime @default(now())
  recipeId  String?
  recipe    Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@unique([weekStart, dayOfWeek, mealType])
  @@index([recipeId])
}

model MealLog {
  id       String   @id @default(cuid())
  eaten    Boolean  @default(false)
  mealType MealType
  notes    String?
  dayId    String
  day      Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  recipeId String?
  recipe   Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@unique([dayId, mealType])
  @@index([recipeId])
}

enum MealType {
  CAFE_DA_MANHA
  ALMOCO
  JANTAR
  LANCHE
}

// AVALIAÇÃO
model WeekReview {
  id              String       @id @default(cuid())
  weekStart       DateTime
  weekEnd         DateTime
  effectiveness   Stars?
  energy          Energy?
  biggestBlock    Block?
  executedPlan    Execution?
  foodHydration   Quality?
  houseUpToDate   Boolean      @default(false)
  notes           String?
  nextWeekFocus   String?
  visionAlignment String?
  createdAt       DateTime     @default(now())
  monthReviewId   String?
  monthReview     MonthReview? @relation(fields: [monthReviewId], references: [id], onDelete: SetNull)

  @@unique([weekStart])
  @@index([monthReviewId])
}

model MonthReview {
  id              String         @id @default(cuid())
  month           Int
  year            Int
  effectiveness   Stars?
  highlights      String?
  improvements    String?
  nextMonthGoal   String?
  createdAt       DateTime       @default(now())
  weekReviews     WeekReview[]
  quarterReviewId String?
  quarterReview   QuarterReview? @relation(fields: [quarterReviewId], references: [id], onDelete: SetNull)

  @@unique([month, year])
  @@index([quarterReviewId])
}

model QuarterReview {
  id              String        @id @default(cuid())
  quarter         Int
  year            Int
  highlights      String?
  improvements    String?
  nextQuarterGoal String?
  createdAt       DateTime      @default(now())
  monthReviews    MonthReview[]

  @@unique([quarter, year])
}

model Goal {
  id          String     @id @default(cuid())
  title       String
  description String?
  period      GoalPeriod
  area        GoalArea
  status      GoalStatus @default(EM_ANDAMENTO)
  deadline    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  measuredGoalId String?
  measuredGoal   MeasuredGoal? @relation(fields: [measuredGoalId], references: [id], onDelete: SetNull)

  @@index([measuredGoalId])
}

enum Stars {
  UM
  DOIS
  TRES
  QUATRO
  CINCO
}

enum Block {
  INICIO
  FINALIZACAO
  RESPONDER_PESSOAS
  EMOCIONAL
  ENERGIA
}

enum Execution {
  SIM
  PARCIAL
  NAO
}

enum Quality {
  BEM
  MAIS_OU_MENOS
  DESCUIDEI
}

enum GoalPeriod {
  SEMANAL
  MENSAL
  TRIMESTRAL
  ANUAL
}

enum GoalArea {
  PESSOAL
  FINANCEIRO
  SAUDE
  NEGOCIOS
  ESPIRITUALIDADE
  OUTRO
}

enum GoalStatus {
  EM_ANDAMENTO
  CONCLUIDA
  PAUSADA
  CANCELADA
}

// FINANCEIRO
model Transaction {
  id         String              @id @default(cuid())
  name       String
  type       TransactionType
  amount     Float
  date       DateTime
  category   TransactionCategory
  payMethod  PayMethod?
  notes      String?
  /// Só faz sentido em ENTRADA: `false` é dinheiro previsto que ainda não caiu
  /// na conta. Previsão não entra no saldo do mês — só depois de marcada.
  /// Saída nasce `true`, o campo é ignorado nela.
  received   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  businessId String?
  business   Business?           @relation(fields: [businessId], references: [id], onDelete: SetNull)

  // Preenchida quando a transação é o pagamento de uma fatura (lançado junto
  // com o "marcar como paga"), para desmarcar conseguir desfazer o lançamento.
  paidInvoice CreditCardInvoice?

  @@index([date])
  @@index([type, date])
  @@index([businessId])
  @@index([type, received])
}

enum TransactionType {
  ENTRADA
  SAIDA
}

// Continua em uso só por Task.origin (categorização simples de tarefas do dia).
enum Origin {
  PESSOAL
  ACE
  BIATRIX_TAROT
  CREATIVE
  CASA
}

enum TransactionCategory {
  RECEITA_VENDA
  CONTA_FIXA
  ASSINATURA
  GASTO_PESSOAL
  WEED
  GATOS
  ALIMENTACAO
  CUSTO_OPERACIONAL
  CARTAO_CREDITO
  BELEZA
  OUTRO
}

enum PayMethod {
  CARTAO_CREDITO
  PIX_DEBITO
  DINHEIRO
  TRANSFERENCIA
}

model FixedBill {
  id     String        @id @default(cuid())
  name   String
  amount Float
  dueDay Int
  type   FixedBillType
  // Conta paga no cartão entra sozinha na fatura do mês — não precisa (nem deve)
  // ter um CreditCardEntry manual, senão o valor conta duas vezes.
  paymentMethod PayMethod @default(PIX_DEBITO)
  active        Boolean   @default(true)
  notes         String?
  createdAt     DateTime  @default(now())
  monthlyLogs   FixedBillLog[]

  @@index([active, paymentMethod])
}

enum FixedBillType {
  ASSINATURA_PESSOAL
  ASSINATURA_TRABALHO
  CONTA_CASA
}

model FixedBillLog {
  id          String     @id @default(cuid())
  month       Int
  year        Int
  // Data real do vencimento naquele mês (gerada a partir de FixedBill.dueDay).
  dueDate     DateTime
  status      BillStatus @default(PENDENTE)
  // Valor só daquele mês, quando difere do padrão da conta (reajuste, consumo
  // variável). Nulo = usa FixedBill.amount.
  amountOverride Float?
  paidAt      DateTime?
  fixedBillId String
  fixedBill   FixedBill  @relation(fields: [fixedBillId], references: [id], onDelete: Cascade)

  @@unique([fixedBillId, month, year])
  @@index([year, month, status])
}

enum BillStatus {
  PAGO
  PENDENTE
  ATRASADO
}

// Configuração do cartão — registro único (id fixo CREDIT_CARD_ID).
model CreditCard {
  id         String   @id
  name       String   @default("Cartão de crédito")
  // Dia em que a fatura fecha — usado só para sugerir a fatura de uma compra nova.
  closingDay Int?
  dueDay     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Fatura de um mês. Só existe a partir do momento em que é paga — mês sem
/// linha aqui é fatura em aberto. É ela que responde "essa fatura foi paga?":
/// as assinaturas cobradas no cartão não têm status próprio, elas seguem o
/// status da fatura, porque não são pagas separadamente.
model CreditCardInvoice {
  id         String        @id @default(cuid())
  month      Int
  year       Int
  status     InvoiceStatus @default(ABERTA)
  paidAt     DateTime?
  /// O quanto de fato saiu — pode diferir do total da fatura (pagamento
  /// parcial, valor mínimo).
  paidAmount Float?
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  paymentTransactionId String?      @unique
  paymentTransaction   Transaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  @@unique([month, year])
  @@index([status])
}

enum InvoiceStatus {
  ABERTA
  PAGA
}

// Compra parcelada: agrupa as parcelas espalhadas pelas faturas.
model CreditCardPurchase {
  id           String              @id @default(cuid())
  description  String
  totalAmount  Float
  installments Int
  purchaseDate DateTime
  category     TransactionCategory
  notes        String?
  createdAt    DateTime            @default(now())
  businessId   String?
  business     Business?           @relation(fields: [businessId], references: [id], onDelete: SetNull)
  entries      CreditCardEntry[]

  @@index([businessId])
}

model CreditCardEntry {
  id           String              @id @default(cuid())
  description  String
  amount       Float
  purchaseDate DateTime
  invoiceMonth Int
  invoiceYear  Int
  installment  String?
  category     TransactionCategory
  notes        String?
  createdAt    DateTime            @default(now())
  businessId   String?
  business     Business?           @relation(fields: [businessId], references: [id], onDelete: SetNull)
  purchaseId   String?
  purchase     CreditCardPurchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  // Parcelamento em campos próprios: `installment` é só o rótulo "2/6", que a
  // projeção não consegue somar nem ordenar. Preenchidos junto com `purchaseId`
  // (o grupo é o id da compra), então uma parcela se identifica sem JOIN.
  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?

  @@index([invoiceYear, invoiceMonth])
  @@index([businessId])
  @@index([purchaseId])
  @@index([installmentGroupId])
}

model FinancialRecord {
  id           String              @id @default(cuid())
  name         String
  type         FinancialRecordType
  totalAmount  Float
  paidAmount   Float               @default(0)
  installments Int?
  dueDay       Int?
  status       FinancialStatus     @default(EM_ABERTO)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

enum FinancialRecordType {
  DIVIDA
  INVESTIMENTO
}

enum FinancialStatus {
  EM_ABERTO
  PARCIAL
  QUITADO
}

// NEGÓCIOS E CLIENTES
model Business {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#6366F1")
  icon        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clients             ClientBusiness[]
  projects            Project[]
  tasks               Task[]
  transactions        Transaction[]
  creditCardEntries   CreditCardEntry[]
  creditCardPurchases CreditCardPurchase[]
  ideas               Idea[]
  contentPosts        ContentPost[]
  productionTasks     ProductionTask[]
  modules             BusinessModule[]
  orders              Order[]
  collections         Collection[]
  wishlistItems       WishlistItem[]
  credentials         BusinessCredential[]
  products            Product[]
}

// Mesma ponte do ProjectCredential, um nível acima: senhas do negócio inteiro
// (Instagram da marca, banco, ferramentas) que não são de um projeto só.
model BusinessCredential {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  passwordEntryId String
  passwordEntry   PasswordEntry @relation(fields: [passwordEntryId], references: [id], onDelete: Cascade)

  @@unique([businessId, passwordEntryId])
  @@index([businessId])
  @@index([passwordEntryId])
}

// Funcionalidades ligadas por negócio: as abas da página do negócio saem daqui,
// na ordem gravada. Desativar um módulo só esconde a aba — nenhum dado é apagado.
model BusinessModule {
  id        String     @id @default(cuid())
  module    ModuleType
  active    Boolean    @default(true)
  order     Int        @default(0)
  createdAt DateTime   @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, module])
  @@index([businessId, order])
}

enum ModuleType {
  CRONOGRAMA // posts, stories, reels
  PRODUCAO // tarefas de edição, arte, site
  CLIENTES // gestão de clientes
  PROJETOS // projetos internos e de cliente
  PEDIDOS // controle de pedidos (loja)
  COLECOES // coleções sazonais de produtos
  FINANCEIRO // visão financeira do negócio
  SENHAS // credenciais do negócio, vindas do cofre
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(EM_ANDAMENTO)
  startDate   DateTime?
  endDate     DateTime?
  // Projeto do próprio negócio, sem cliente do outro lado.
  isInternal  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Documentação livre do projeto (markdown): briefing, anotações, combinados.
  content String?

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tasks      Task[]

  contentPosts    ContentPost[]
  productionTasks ProductionTask[]

  documents   ProjectDocument[]
  credentials ProjectCredential[]
  priceTable  ProjectPriceItem[]

  @@index([businessId])
  @@index([clientId])
}

// Links e arquivos do projeto: briefing no Drive, protótipo no Figma, contrato.
model ProjectDocument {
  id        String       @id @default(cuid())
  title     String
  url       String
  type      DocumentType @default(LINK)
  notes     String?
  order     Int          @default(0)
  createdAt DateTime     @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum DocumentType {
  LINK
  DRIVE
  FIGMA
  BRIEFING
  CONTRATO
  OUTRO
}

// Ponte para o cofre de senhas: a senha continua morando só no PasswordEntry,
// aqui fica apenas o vínculo com o projeto.
model ProjectCredential {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  passwordEntryId String
  passwordEntry   PasswordEntry @relation(fields: [passwordEntryId], references: [id], onDelete: Cascade)

  @@unique([projectId, passwordEntryId])
  @@index([projectId])
  @@index([passwordEntryId])
}

// Tabela de preços combinada para o projeto.
model ProjectPriceItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  // Ex.: "por post", "mensal", "por hora".
  unit        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum ProjectStatus {
  EM_ANDAMENTO
  CONCLUIDO
  PAUSADO
  CANCELADO
}

model Client {
  id            String           @id @default(cuid())
  name          String
  email         String?
  phone         String?
  instagram     String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  businessLinks ClientBusiness[]
  projects      Project[]

  contentPosts    ContentPost[]
  productionTasks ProductionTask[]
}

model ClientBusiness {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status     ClientStatus @default(ATIVO)
  notes      String?
  joinedAt   DateTime     @default(now())
  clientId   String
  client     Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, businessId])
  @@index([businessId, status])
}

enum ClientStatus {
  ATIVO
  PAUSADO
  INATIVO
}

// CRONOGRAMA DE CONTEÚDO E PRODUÇÃO
// Sempre de um negócio; `clientId` nulo = conteúdo interno do próprio negócio.
model ContentPost {
  id          String        @id @default(cuid())
  title       String
  type        PostType
  network     SocialNetwork
  status      ContentStatus @default(PLANEJADO)
  publishDate DateTime?
  completedAt DateTime?
  caption     String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([businessId, publishDate])
  @@index([clientId])
  @@index([projectId])
}

enum PostType {
  STORY
  REELS
  FEED_FOTO
  FEED_VIDEO
  CARROSSEL
}

enum SocialNetwork {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  LINKEDIN
  FACEBOOK
  OUTRO
}

enum ContentStatus {
  PLANEJADO
  EM_CRIACAO
  APROVADO
  PUBLICADO
  CANCELADO
}

// `clientId` nulo = tarefa interna do próprio negócio.
model ProductionTask {
  id          String           @id @default(cuid())
  title       String
  type        ProductionType
  description String?
  priority    Priority         @default(NORMAL)
  status      ProductionStatus @default(A_FAZER)
  dueDate     DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  subtasks Subtask[]

  @@index([businessId, status])
  @@index([businessId, dueDate])
  @@index([dueDate, status])
  @@index([clientId])
  @@index([projectId])
}

enum ProductionType {
  EDICAO_VIDEO
  CRIACAO_ARTE
  SITE
  FOTOGRAFIA
  COPY
  OUTRO
}

enum Priority {
  NORMAL
  URGENTE
}

enum ProductionStatus {
  A_FAZER
  EM_ANDAMENTO
  AGUARDANDO_APROVACAO
  CONCLUIDO
  CANCELADO
}

// LOJA — PEDIDOS E COLEÇÕES (módulos PEDIDOS e COLECOES)
model Order {
  id              String      @id @default(cuid())
  orderNumber     String?
  customerName    String
  customerContact String?
  // Derivados dos itens, gravados: o kanban e a visão geral do negócio leem
  // dezenas de pedidos e não podem somar item por item a cada tela. Quem
  // mantém os dois em dia é a API, sempre que os itens mudam.
  totalAmount     Float       @default(0)
  totalCost       Float       @default(0)
  status          OrderStatus @default(PENDENTE)
  orderDate       DateTime    @default(now())
  dueDate         DateTime?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  items OrderItem[]

  @@index([businessId, status])
  @@index([businessId, dueDate])
  @@index([collectionId])
}

// Uma linha do pedido.
//
// Nome, preço e custo ficam CONGELADOS aqui, copiados no dia do pedido. Sem
// isso, reajustar a caneca em janeiro reescreveria o lucro de um pedido de
// dezembro que já foi pago — o histórico deixaria de ser histórico. As ligações
// com produto e peça existem só para rastrear a origem, e podem sumir sem levar
// a linha junto.
model OrderItem {
  id        String   @id @default(cuid())
  name      String
  quantity  Int      @default(1)
  unitPrice Float
  unitCost  Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  collectionProductId String?
  collectionProduct   CollectionProduct? @relation(fields: [collectionProductId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([collectionProductId])
}

enum OrderStatus {
  PENDENTE
  EM_PRODUCAO
  PRONTO
  ENVIADO
  ENTREGUE
  CANCELADO
}

model Collection {
  id          String           @id @default(cuid())
  name        String
  description String?
  season      String?
  status      CollectionStatus @default(IDEIA)
  launchDate  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  products CollectionProduct[]
  orders   Order[]
  tasks    CollectionTask[]

  @@index([businessId, status])
}

// Tarefas da coleção: costurar, fotografar, montar o lookbook.
model CollectionTask {
  id          String    @id @default(cuid())
  title       String
  description String?
  done        Boolean   @default(false)
  dueDate     DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  subtasks Subtask[]

  @@index([collectionId, order])
  // As tarefas do dia varrem por prazo em aberto.
  @@index([dueDate, done])
}

enum CollectionStatus {
  IDEIA
  EM_DESENVOLVIMENTO
  PRONTA
  LANCADA
  ENCERRADA
}

// CENTRAL DE PRODUTOS — o catálogo de produtos personalizados.
//
// Vale para todos os negócios de propósito: a mesma caneca é vendida pela
// Creative, pela Alternative Space e pela EntreMundos. Antes cada coleção
// recadastrava o produto do zero, então "Caneca Rick" e "Caneca Ostara" eram
// dois cadastros sem relação e o custo se perdia — subiu o preço do blank,
// nenhuma margem do app ficava certa.
//
// Aqui mora a BASE (o item físico e o que custa produzir uma unidade). A arte
// aplicada e o preço daquela temporada ficam no CollectionProduct.
model Product {
  id          String  @id @default(cuid())
  name        String
  description String?
  // Agrupador livre para filtrar a lista: "Canecas", "Vestuário", "Decoração".
  category    String?
  imageUrl    String?
  // Preço de venda padrão. Cada coleção pode sobrescrever.
  basePrice   Float?
  // Margem desejada deste produto, em %. Sem valor, usa a das configurações.
  targetMargin Float?
  active      Boolean @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Nulo = produto disponível para qualquer negócio (o caso normal).
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  costItems       ProductCostItem[]
  collectionItems CollectionProduct[]
  orderItems      OrderItem[]

  @@index([active, name])
  @@index([businessId])
}

// BIBLIOTECA DE INSUMOS
//
// O que você compra em pacote e gasta por peça: papel transfer, tinta, fita,
// caixa. O preço fica guardado como você compra de verdade — R$120 o pacote de
// 50 — e o app divide para achar o custo por unidade.
//
// Existe para o reajuste ser um lugar só: subiu o pacote de transfer, todo
// produto que usa transfer recalcula a margem sozinho. Sem isso, o mesmo número
// estaria copiado à mão em oito produtos e nenhum ficaria certo por muito tempo.
model Material {
  id   String  @id @default(cuid())
  name String
  // A unidade que o produto consome: "folha", "metro", "ml", "un".
  unit String?
  // Como você compra: preço do pacote e quantas unidades vêm nele.
  packPrice    Float
  packQuantity Float   @default(1)
  supplier     String?
  notes        String?
  createdAt    DateTime @default(now())
  // Quando o preço foi mexido pela última vez — insumo com preço velho é a
  // causa mais comum de margem errada.
  updatedAt    DateTime @updatedAt

  costItems ProductCostItem[]

  @@index([name])
}

// Cada linha do custo de um produto: o blank, a impressão, a embalagem, o seu
// tempo, a taxa da maquininha. Lista aberta em vez de campos fixos porque cada
// produto tem uma composição diferente — chinelo não tem sublimação de caneca.
model ProductCostItem {
  id    String          @id @default(cuid())
  label String
  kind  ProductCostKind @default(MATERIAL)
  mode  ProductCostMode @default(FIXO)
  // O que `amount` significa depende do modo: reais (FIXO), porcentagem do
  // preço de venda (PERCENTUAL), minutos de trabalho (TEMPO) ou quantas
  // unidades do insumo a peça consome (INSUMO).
  amount Float
  order  Int      @default(0)
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Só no modo INSUMO. Restrict: apagar um insumo em uso zeraria em silêncio o
  // custo de todo produto que depende dele — a API avisa e manda desfazer antes.
  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([productId, order])
  @@index([materialId])
}

enum ProductCostKind {
  MATERIAL // o blank: a caneca crua, a almofada, a camiseta
  IMPRESSAO // sublimação, DTF, transfer, tinta
  EMBALAGEM
  MAO_DE_OBRA
  FRETE
  TAXA // maquininha, marketplace, imposto
  OUTRO
}

enum ProductCostMode {
  FIXO // R$ por unidade
  PERCENTUAL // % do preço de venda — taxa de maquininha, comissão de marketplace
  TEMPO // minutos × valor/hora das configurações
  INSUMO // quantidade × custo unitário de um Material da biblioteca
}

// O produto dentro de uma coleção: a base do catálogo + a arte daquela peça.
//
// Sem unique em (collectionId, productId): a mesma caneca aparece várias vezes
// na coleção, uma por arte ("Caneca Rick", "Caneca Morty").
model CollectionProduct {
  id String @id @default(cuid())
  // Nome da peça nesta coleção ("Caneca Rick"). Vazio = usa o nome da base.
  name        String?
  description String?
  imageUrl    String?
  notes       String?
  // Preço nesta coleção. Nulo = herda o basePrice do produto, então reajustar
  // a base propaga para todas as coleções que não pediram preço próprio.
  price     Float?
  // Custo que só existe nesta peça: arte exclusiva, tag bordada, embalagem
  // especial. Soma ao custo da base em vez de substituí-lo.
  extraCost Float?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  orderItems OrderItem[]

  @@index([collectionId, order])
  @@index([productId])
}

// BIBLIOTECA DE LIVROS
model Book {
