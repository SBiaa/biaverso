// LISTA DE DESEJOS
//
// "Para o que é" tem dois eixos, porque uma coisa só não responde: `businessId`
// diz de quem é a vontade (nulo = pessoal/casa, o mesmo padrão do resto do app)
// e `category` diz que tipo de coisa é. Um notebook da Ace e um notebook seu
// são o mesmo tipo de item com destinos diferentes.
model WishlistItem {
  id          String       @id @default(cuid())
  name        String
  description String?
  /// Link da loja onde viu.
  url         String?
  imageUrl    String?
  /// Quanto custa, para saber o tamanho da lista. Nem todo desejo tem preço.
  price       Float?
  priority    WishPriority @default(QUERO)
  status      WishStatus   @default(DESEJADO)
  category    WishCategory @default(OUTRO)
  /// Quando quer ter (aniversário, viagem, prazo de um projeto).
  targetDate  DateTime?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  /// Preenchidos ao marcar como comprado — o preço pago pode não ser o previsto.
  boughtAt    DateTime?
  boughtPrice Float?

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([status, priority])
  @@index([businessId])
  @@index([category])
}

enum WishPriority {
  ESSENCIAL
  QUERO
  ALGUM_DIA
}

enum WishStatus {
  DESEJADO
  COMPRADO
  DESCARTADO
}

enum WishCategory {
  EQUIPAMENTO
  SOFTWARE
  CASA
  ROUPA
  BELEZA
  LIVRO_CURSO
  PRESENTE
  VIAGEM
  SAUDE
  OUTRO
}

// BANCO DE IDEIAS
model Idea {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      IdeaStatus @default(SOLTA)
  tags        String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  businessId  String?
  business    Business?  @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId])
}

enum IdeaStatus {
  SOLTA
  EM_ANALISE
  VIROU_PROJETO
  ARQUIVADA
}

// COFRE DE SENHAS
model PasswordEntry {
  id        String           @id @default(cuid())
  name      String
  login     String?
  // Cifrada (AES-256-GCM, ver lib/crypto.ts): o valor aqui é "v1:iv:tag:cifra".
  // Só passa por lib/passwords.ts para voltar a ser legível.
  password  String
  url       String?
  category  PasswordCategory @default(OUTRO)
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  projectLinks  ProjectCredential[]
  businessLinks BusinessCredential[]
}

enum PasswordCategory {
  REDES_SOCIAIS
  TRABALHO
  FINANCEIRO
  STREAMING
  FERRAMENTAS
  OUTRO
}

// CENTRAL DE VISÃO — conecta os grandes propósitos da vida com as ações do dia a dia

// PILARES — grandes áreas da vida
model Pillar {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#6366F1")
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conceptualGoals ConceptualGoal[]
  moodboardItems  MoodboardItem[]
  desires         Desire[]
  principles      Principle[]
}

// PRINCÍPIOS E VALORES — o "por que" de tudo
model Principle {
  id        String   @id @default(cuid())
  title     String
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pillarId String?
  pillar   Pillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)

  @@index([pillarId])
}

// OBJETIVOS CONCEITUAIS — o que quer ser/ter/sentir
model ConceptualGoal {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pillarId      String
  pillar        Pillar         @relation(fields: [pillarId], references: [id], onDelete: Cascade)
  measuredGoals MeasuredGoal[]

  @@index([pillarId])
}

// OBJETIVOS METRIFICADOS — versão mensurável com prazo
model MeasuredGoal {
  id        String             @id @default(cuid())
  title     String
  target    String?
  deadline  DateTime?
  status    MeasuredGoalStatus @default(EM_ANDAMENTO)
  progress  Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  conceptualGoalId String
  conceptualGoal   ConceptualGoal @relation(fields: [conceptualGoalId], references: [id], onDelete: Cascade)
  goals            Goal[]

  @@index([conceptualGoalId])
  @@index([status])
}

enum MeasuredGoalStatus {
  EM_ANDAMENTO
  CONCLUIDO
  PAUSADO
  CANCELADO
}

// DESEJOS E INTENÇÕES — sonhos sem prazo
model Desire {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pillarId String?
  pillar   Pillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)

  @@index([pillarId])
}

// MOODBOARD — imagens, palavras e frases por pilar
model MoodboardItem {
  id        String        @id @default(cuid())
  type      MoodboardType
  content   String
  caption   String?
  order     Int           @default(0)
  createdAt DateTime      @default(now())

  pillarId String
  pillar   Pillar @relation(fields: [pillarId], references: [id], onDelete: Cascade)

  @@index([pillarId, order])
}

enum MoodboardType {
  IMAGEM
  PALAVRA
  FRASE
}

// PREFERÊNCIAS DO APP — registro único (id fixo USER_SETTINGS_ID).
model UserSettings {
  id          String   @id
  // Quantas garrafas/copos por dia e quantos ml cada um tem.
  waterGoal   Int      @default(8)
  waterUnitMl Int      @default(300)
  // Quanto vale uma hora do seu trabalho — vira o custo dos itens em modo
  // TEMPO. Nulo = você ainda não definiu, e o app avisa em vez de contar zero.
  hourlyRate  Float?
  // Margem de lucro desejada, em %. Base do preço sugerido no catálogo.
  targetMargin Float   @default(60)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// BELEZA E AUTOCUIDADO
//
// Três ritmos diferentes, por isso três modelos em vez de um só:
// rotina = todo dia; cronograma = ciclo que gira (capilar); cuidado = a cada N dias.

// ROTINAS DIÁRIAS (skincare manhã/noite, cuidados diários)
model CareRoutine {
  id        String      @id @default(cuid())
  name      String
  timeOfDay RoutineTime
  active    Boolean     @default(true)
  order     Int         @default(0)
  // Passos marcáveis um a um, ou lista numerada só de leitura. É por rotina:
  // a do banho quer checklist, a de maquiagem pode ser só uma ordem para ler.
  checklist Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  steps CareRoutineStep[]
  logs  CareRoutineLog[]

  @@index([active, order])
}

enum RoutineTime {
  MANHA
  NOITE
  QUALQUER
}

// PASSOS DE UMA ROTINA (ex: 1. limpar, 2. tônico, 3. sérum)
model CareRoutineStep {
  id    String  @id @default(cuid())
  title String
  notes String?
  order Int     @default(0)

  routineId String
  routine   CareRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  productId String?
  product   BeautyProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  logs CareRoutineStepLog[]

  @@index([routineId, order])
  @@index([productId])
}

// REGISTRO DIÁRIO DE PASSO CUMPRIDO
// Separado do log da rotina porque "3 de 5" é o estado normal no meio da
// manhã: a rotina só fica feita quando todos os passos estão marcados.
model CareRoutineStepLog {
  id   String   @id @default(cuid())
  done Boolean  @default(false)
  date DateTime

  stepId String
  step   CareRoutineStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId, date])
  @@index([date])
}

// REGISTRO DIÁRIO DE ROTINA CUMPRIDA
// `date` é meia-noite UTC do dia, como todo dia-calendário do app.
model CareRoutineLog {
  id   String   @id @default(cuid())
  done Boolean  @default(false)
  date DateTime

  routineId String
  routine   CareRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, date])
  @@index([date])
}

// CRONOGRAMAS COM CICLO (capilar, etc)
model CareSchedule {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  // Índice do passo atual no ciclo — anda sozinho a cada etapa registrada e
  // volta a zero no fim, então o ciclo gira sem precisar de data fixa.
  currentStep Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps CareScheduleStep[]
  logs  CareScheduleLog[]

  @@index([active])
}

// PASSOS DO CICLO (ex: hidratação → nutrição → reconstrução)
model CareScheduleStep {
  id           String  @id @default(cuid())
  title        String
  description  String?
  order        Int     @default(0)
  intervalDays Int     @default(7)

  scheduleId String
  schedule   CareSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  productId String?
  product   BeautyProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  logs CareScheduleLog[]

  @@index([scheduleId, order])
  @@index([productId])
}

// REGISTRO DE ETAPA DO CICLO REALIZADA
model CareScheduleLog {
  id        String   @id @default(cuid())
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  scheduleId String
  schedule   CareSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  // Cascade também aqui: sem o passo, a linha do histórico não diz mais o que
  // foi feito. Restrict (o padrão) só faria a exclusão do passo falhar com P2003.
  stepId String
  step   CareScheduleStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([scheduleId, date])
  @@index([stepId])
}

// CUIDADOS AGENDADOS (unhas, cabelo, depilação)
model CareAppointment {
  id           String    @id @default(cuid())
  name         String
  type         CareType
  intervalDays Int
  lastDoneAt   DateTime?
  // Derivado de lastDoneAt + intervalDays. Fica gravado para a lista poder
  // ordenar e filtrar por vencimento direto no banco.
  nextDueAt    DateTime?
  notes        String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  logs CareAppointmentLog[]

  @@index([active, nextDueAt])
}

enum CareType {
  UNHAS
  CABELO
  DEPILACAO
  SOBRANCELHA
  ESTETICA
  MASSAGEM
  OUTRO
}

// HISTÓRICO DE CUIDADOS REALIZADOS
model CareAppointmentLog {
  id        String   @id @default(cuid())
  date      DateTime
  cost      Float?
  notes     String?
  createdAt DateTime @default(now())

  appointmentId String
  appointment   CareAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, date])
}

// PRODUTOS DE BELEZA
model BeautyProduct {
  id        String          @id @default(cuid())
  name      String
  brand     String?
  category  ProductCategory
  openedAt  DateTime?
  // Calculado a partir de openedAt + pao quando os dois existem; também pode
  // ser preenchido na mão para produto com validade impressa.
  expiresAt DateTime?
  // Period After Opening em meses (o "12M" do potinho).
  pao       Int?

  finished   Boolean   @default(false)
  finishedAt DateTime?
  // Marcado na mão quando o produto está no fim — é o que alimenta o card
  // "quase acabando", já que o app não tem como medir o que sobrou no pote.
  runningLow Boolean   @default(false)
  cost       Float?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  routineSteps  CareRoutineStep[]
  scheduleSteps CareScheduleStep[]

  @@index([finished, category])
  @@index([expiresAt])
  @@index([runningLow])
}

enum ProductCategory {
  SKINCARE_LIMPEZA
  SKINCARE_TRATAMENTO
  SKINCARE_HIDRATACAO
  SKINCARE_PROTECAO
  CABELO_SHAMPOO
