# Connection string do Postgres (Neon). Copie para .env e preencha com a sua.
# Esta é a do pooler (host com "-pooler"), usada pelo app em runtime.
DATABASE_URL="postgresql://usuario:senha@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# A MESMA string, mas com o host sem "-pooler". Usada só pelas migrations:
# advisory lock é de sessão e o pooler não garante isso, o que trava o
# `migrate deploy` com P1002. Ver prisma.config.ts.
DIRECT_DATABASE_URL="postgresql://usuario:senha@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Google Calendar — credenciais OAuth 2.0 do Google Cloud Console.
# Passo a passo para gerar: seção "Google Calendar" do README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Chave que cifra as senhas do cofre e os tokens do Google no banco.
# Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# ⚠️ Guarde uma cópia fora do .env (gerenciador de senhas, papel). Perdeu a
# chave, perdeu o cofre — não existe recuperação. Ver README, seção Criptografia.
ENCRYPTION_KEY=

# Senha única que protege o app inteiro (Basic Auth, ver middleware.ts).
# Definida = vale em qualquer ambiente. Vazia = só funciona em desenvolvimento;
# em produção o app responde 503 para não subir aberto por esquecimento.
# APP_USER é opcional e o padrão é "bia".
APP_USER=bia
APP_PASSWORD=
